# Copy to .env (git-ignored) to change these settings. Every value is optional.

# Base URL of the API. Default: /api/v1
VITE_API_BASE_URL=/api/v1

# Mock API (MSW) in the browser instead of the real API. Default: off, so the
# app talks to the backend, which the dev server proxies (see vite.config.ts).
# Set to true to work on the UI without running the backend.
VITE_USE_MOCKS=false

# SignalR hub for live stock and queue updates. Default: /hubs/live (proxied).
# VITE_LIVE_HUB_URL=/hubs/live

# Currency symbol shown before amounts. Default: Rs
VITE_CURRENCY_SYMBOL=Rs

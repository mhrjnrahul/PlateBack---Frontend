# Copy to .env (git-ignored) to change these settings. Every value is optional.

# Base URL of the API. Default: /api/v1
VITE_API_BASE_URL=/api/v1

# Mock API (MSW) in the browser, so the app works without a backend.
# Default: on. Set to false once the real API is running (Week 4).
VITE_USE_MOCKS=true
